{
    "name": "@frontia/react-native-fast-image",
    "version": "10.11.0-frontia.1",
    "frontiaCapabilities": {
        "androidMaxPixelDensity": true
    },
    "description": "FastImage, performant React Native image component.",
    "keywords": [
        "cache",
        "cached",
        "fastimage",
        "image",
        "priority"
    ],
    "homepage": "https://github.com/deepgrov/react-native-fast-image-upstream#readme",
    "bugs": {
        "url": "https://github.com/deepgrov/react-native-fast-image-upstream/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepgrov/react-native-fast-image-upstream.git"
    },
    "license": "(MIT AND Apache-2.0)",
    "author": "Dylan Vann <dylan@dylanvann.com> (https://dylanvann.com)",
    "main": "dist/index.cjs",
    "module": "dist/index",
    "react-native": "src/index",
    "browser": "dist/index.web.js",
    "typings": "dist/index.d.ts",
    "files": [
        "android/build.gradle",
        "android/consumer-rules.pro",
        "android/src/main",
        "common/cpp",
        "ios/FastImage",
        "app.plugin.js",
        "src",
        "!src/**/*.test.tsx",
        "!src/**/*.test.ts",
        "!src/__snapshots__",
        "dist",
        "react-native.config.js",
        "RNFastImage.podspec",
        "thumbhash"
    ],
    "scripts": {
        "build": "bun run build:package && bun run build:docs",
        "build:package": "rm -rf dist && tsc -p tsconfig.build.json && rolldown -c",
        "build:docs": "bun run --cwd website build",
        "lint": "oxlint",
        "release": "semantic-release",
        "test": "bun test",
        "typecheck": "tsc -p tsconfig.json",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "packageManager": "bun@1.4.2",
    "resolutions": {
        "@types/react": "^19.2.0"
    },
    "devDependencies": {
        "@semantic-release/changelog": "7.0.0",
        "@semantic-release/git": "11.0.1",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "conventional-changelog-angular": "8.3.1",
        "maestro-runner": "1.1.27",
        "odiff-bin": "^4.5.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "playwright-core": "1.64.1",
        "pretty-format": "^30.5.1",
        "react": "19.2.0",
        "react-native": "0.83.10",
        "react-test-renderer": "19.2.0",
        "rolldown": "1.2.11",
        "semantic-release": "25.0.9",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*"
    },
    "codegenConfig": {
        "name": "RNFastImageSpec",
        "type": "all",
        "jsSrcsDir": "src/specs",
        "android": {
            "javaPackageName": "com.fastimage"
        },
        "ios": {
            "componentProvider": {
                "FastImageView": "FFFastImageViewComponentView",
                "FastImageAutoView": "FFFastImageAutoViewComponentView"
            },
            "modulesProvider": {
                "FastImageModule": "FFFastImageModule"
            }
        }
    }
}
